{
  "name": "serverlab-simulator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check": "tsc --noEmit && node --check public/client/client.js && node --check public/client/os.js",
    "test": "vitest run && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@xyflow/react": "12.11.6",
    "dexie": "4.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
